@prefix scf: <https://example.invalid/scf/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://example.invalid/scf/ontology> a owl:Ontology ; rdfs:label "Shopping Content Factory 지식체계"@ko .

scf:Deliverable a owl:Class ; rdfs:label "산출물"@ko ; rdfs:comment "요구서 16장 최종 산출물 20개"@ko .
scf:Criterion a owl:Class ; rdfs:label "완료 기준"@ko ; rdfs:comment "요구서 17장 MVP 완료 판정 15개"@ko .
scf:Phase a owl:Class ; rdfs:label "단계"@ko ; rdfs:comment "PHASE 1~5 · STEP 1~10 · 수정 로드맵"@ko .
scf:PlanChange a owl:Class ; rdfs:label "기획 수정안"@ko ; rdfs:comment "원 기획 대비 수정"@ko .
scf:Concept a owl:Class ; rdfs:label "도메인 개념"@ko ; rdfs:comment "시스템이 다루는 업무 개념(도메인 온톨로지)"@ko .
scf:Component a owl:Class ; rdfs:label "구현 요소"@ko ; rdfs:comment "코드·설정·스크립트 모듈"@ko .
scf:Verification a owl:Class ; rdfs:label "검증"@ko ; rdfs:comment "pytest·브라우저 점검·시뮬레이션·재현"@ko .
scf:Evidence a owl:Class ; rdfs:label "증거"@ko ; rdfs:comment "실행 결과물·재현 기록"@ko .
scf:Document a owl:Class ; rdfs:label "문서"@ko ; rdfs:comment "README 와 docs/"@ko .
scf:Action a owl:Class ; rdfs:label "자동화 액션"@ko ; rdfs:comment "6계층 자동화 액션"@ko .
scf:Party a owl:Class ; rdfs:label "외부 주체"@ko ; rdfs:comment "플랫폼·기관·전문가·고용주·운영자"@ko .
scf:Fact a owl:Class ; rdfs:label "사실"@ko ; rdfs:comment "조사로 확인한 외부 사실(확인 수준 A/B/C)"@ko .
scf:Regulation a owl:Class ; rdfs:label "정책·규정"@ko ; rdfs:comment "법·심사지침·플랫폼 정책·약관"@ko .
scf:Assumption a owl:Class ; rdfs:label "가정"@ko ; rdfs:comment "재무·운영 가정과 판단값"@ko .
scf:Risk a owl:Class ; rdfs:label "리스크"@ko ; rdfs:comment "사업·운영·정책 위험"@ko .
scf:Defect a owl:Class ; rdfs:label "결함·약점"@ko ; rdfs:comment "확인된 결함과 설계상 약점"@ko .
scf:Decision a owl:Class ; rdfs:label "결정"@ko ; rdfs:comment "사용자가 정할 것"@ko .
scf:Metric a owl:Class ; rdfs:label "지표"@ko ; rdfs:comment "측정할 숫자"@ko .

scf:realizes a owl:ObjectProperty ; rdfs:label "충족한다"@ko ; rdfs:domain scf:Component ; rdfs:range scf:Deliverable .
scf:implements a owl:ObjectProperty ; rdfs:label "구현한다"@ko ; rdfs:domain scf:Component ; rdfs:range scf:Concept .
scf:verifies a owl:ObjectProperty ; rdfs:label "검증한다"@ko ; rdfs:domain scf:Verification .
scf:produces a owl:ObjectProperty ; rdfs:label "산출한다"@ko ; rdfs:range scf:Evidence .
scf:describes a owl:ObjectProperty ; rdfs:label "기술한다"@ko ; rdfs:domain scf:Document .
scf:sourcedFrom a owl:ObjectProperty ; rdfs:label "출처"@ko ; rdfs:range scf:Party .
scf:supports a owl:ObjectProperty ; rdfs:label "근거가 된다"@ko .
scf:constrains a owl:ObjectProperty ; rdfs:label "제약한다"@ko ; rdfs:domain scf:Regulation .
scf:feeds a owl:ObjectProperty ; rdfs:label "입력된다"@ko ; rdfs:domain scf:Assumption .
scf:threatens a owl:ObjectProperty ; rdfs:label "위협한다"@ko ; rdfs:domain scf:Risk .
scf:mitigatedBy a owl:ObjectProperty ; rdfs:label "완화된다"@ko ; rdfs:domain scf:Risk .
scf:affects a owl:ObjectProperty ; rdfs:label "영향을 준다"@ko ; rdfs:domain scf:Defect .
scf:resolvedBy a owl:ObjectProperty ; rdfs:label "해결된다"@ko ; rdfs:domain scf:Defect .
scf:foundBy a owl:ObjectProperty ; rdfs:label "발견됐다"@ko ; rdfs:domain scf:Defect .
scf:impacts a owl:ObjectProperty ; rdfs:label "영향 범위"@ko ; rdfs:domain scf:Decision ; rdfs:range scf:Concept .
scf:gates a owl:ObjectProperty ; rdfs:label "선행 조건이다"@ko ; rdfs:domain scf:Decision ; rdfs:range scf:Phase .
scf:decidedBy a owl:ObjectProperty ; rdfs:label "결정 주체"@ko ; rdfs:domain scf:Decision ; rdfs:range scf:Party .
scf:targets a owl:ObjectProperty ; rdfs:label "대상"@ko ; rdfs:domain scf:Action ; rdfs:range scf:Concept .
scf:dependsOn a owl:ObjectProperty ; rdfs:label "필요로 한다"@ko ; rdfs:range scf:Decision .
scf:partOf a owl:ObjectProperty ; rdfs:label "속한다"@ko ; rdfs:domain scf:Phase ; rdfs:range scf:Phase .
scf:deliveredIn a owl:ObjectProperty ; rdfs:label "만든 단계"@ko ; rdfs:domain scf:Deliverable ; rdfs:range scf:Phase .
scf:measures a owl:ObjectProperty ; rdfs:label "측정한다"@ko ; rdfs:domain scf:Metric ; rdfs:range scf:Concept .
scf:provides a owl:ObjectProperty ; rdfs:label "제공한다"@ko ; rdfs:domain scf:Party ; rdfs:range scf:Concept .
scf:domain a owl:ObjectProperty ; rdfs:label "도메인 관계"@ko ; rdfs:domain scf:Concept ; rdfs:range scf:Concept .
scf:supplies a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "공급한다"@ko .
scf:reveals a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "드러낸다"@ko .
scf:belongsTo a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "속한다"@ko .
scf:experiences a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "겪는다"@ko .
scf:blockedBy a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "가로막힌다"@ko .
scf:stimulates a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "자극한다"@ko .
scf:solves a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "해결한다"@ko .
scf:linkedTo a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "연결된다"@ko .
scf:has a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "가진다"@ko .
scf:checkedBy a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "확인된다"@ko .
scf:backs a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "뒷받침한다"@ko .
scf:relieves a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "해소한다"@ko .
scf:evaluates a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "평가한다"@ko .
scf:basedOn a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "근거로 한다"@ko .
scf:judges a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "판정한다"@ko .
scf:checks a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "확인한다"@ko .
scf:selects a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "고른다"@ko .
scf:creates a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "만든다"@ko .
scf:covers a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "다룬다"@ko .
scf:cites a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "인용한다"@ko .
scf:shows a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "보여준다"@ko .
scf:uses a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "사용한다"@ko .
scf:varies a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "바꾼다"@ko .
scf:attachedTo a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "붙는다"@ko .
scf:renderedFrom a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "렌더된다"@ko .
scf:composites a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "합성한다"@ko .
scf:inspects a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "검사한다"@ko .
scf:authorizes a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "허가한다"@ko .
scf:uploads a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "올린다"@ko .
scf:targetsPlatform a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "향한다"@ko .
scf:requiresGate a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "요구한다"@ko .
scf:connects a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "연결한다"@ko .
scf:includes a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "포함한다"@ko .
scf:drivesTrafficTo a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "유입시킨다"@ko .
scf:measuresEvent a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "측정한다"@ko .
scf:occursOn a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "발생한다"@ko .
scf:attributedTo a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "귀속된다"@ko .
scf:aggregates a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "집계한다"@ko .
scf:reads a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "읽는다"@ko .
scf:calibrates a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "보정한다"@ko .
scf:constrainsRule a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "제약한다"@ko .
scf:defines a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "정의한다"@ko .
scf:executes a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "실행한다"@ko .
scf:limits a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "제한한다"@ko .
scf:records a owl:ObjectProperty ; rdfs:subPropertyOf scf:domain ; rdfs:label "기록한다"@ko .
scf:status a owl:DatatypeProperty ; rdfs:label "상태"@ko .
scf:description a owl:DatatypeProperty ; rdfs:label "설명"@ko .
scf:confidence a owl:DatatypeProperty ; rdfs:label "확인 수준"@ko .
scf:level a owl:DatatypeProperty ; rdfs:label "수준"@ko .
scf:kind a owl:DatatypeProperty ; rdfs:label "종류"@ko .
scf:path a owl:DatatypeProperty ; rdfs:label "경로"@ko .
scf:area a owl:DatatypeProperty ; rdfs:label "영역"@ko .
scf:maturity a owl:DatatypeProperty ; rdfs:label "성숙도"@ko .
scf:inputType a owl:DatatypeProperty ; rdfs:label "입력 유형"@ko .

scf:keyword a scf:Concept ;
    rdfs:label "키워드"@ko ;
    scf:description "트렌드 소스에서 온 쇼핑·검색 키워드. 값은 묶음마다 최댓값 100인 상대지수이며 검색량·판매량이 아니다."@ko ;
    scf:status "now" ;
    scf:area "① 수요"@ko ;
    scf:maturity "M2"@ko ;
    scf:inputType "system"@ko .
scf:persona a scf:Concept ;
    rdfs:label "고객 페르소나"@ko ;
    scf:description "이 상품이 필요한 사람. 생활 맥락까지 구체적으로(예: 모니터 2대 쓰는 재택근무자)."@ko ;
    scf:status "short" ;
    scf:area "① 수요"@ko ;
    scf:maturity "M1"@ko ;
    scf:inputType "human"@ko .
scf:problem a scf:Concept ;
    rdfs:label "고객 문제"@ko ;
    scf:description "표면 문제 뒤의 실제 불편. 반복 상황과 잃는 것(시간·공간·돈·노력), 상품이 해결 못 하는 것까지 포함."@ko ;
    scf:status "short" ;
    scf:area "① 수요"@ko ;
    scf:maturity "M1"@ko ;
    scf:inputType "human"@ko .
scf:barrier a scf:Concept ;
    rdfs:label "구매 장벽"@ko ;
    scf:description "구매를 망설이게 하는 가장 큰 이유와, 그것을 푸는 결정적 정보(대개 사양 1~2개)."@ko ;
    scf:status "short" ;
    scf:area "① 수요"@ko ;
    scf:maturity "M1"@ko ;
    scf:inputType "human"@ko .
scf:lever a scf:Concept ;
    rdfs:label "심리 요소"@ko ;
    scf:description "허용 목록 12개 중 상품에 맞는 1~2개만. 거짓 희소성·가짜 후기류는 목록에 없다."@ko ;
    scf:status "done" ;
    scf:area "① 수요"@ko ;
    scf:maturity "M3"@ko ;
    scf:inputType "system"@ko .
scf:category a scf:Concept ;
    rdfs:label "카테고리"@ko ;
    scf:description "초기 타깃 5개(책상·케이블, 좁은 공간, 원룸 수납, 세탁·청소, 무타공). 카테고리마다 필수 사양이 다르다."@ko ;
    scf:status "out" ;
    scf:area "② 상품"@ko ;
    scf:maturity "M0"@ko ;
    scf:inputType "human"@ko .
scf:product a scf:Concept ;
    rdfs:label "상품"@ko ;
    scf:description "제휴 링크를 걸 수 있는 실제 상품. 이름·사양·장단점·주의사항을 묶은 '사실 해시'로 변경을 감지한다."@ko ;
    scf:status "mid" ;
    scf:area "② 상품"@ko ;
    scf:maturity "M1"@ko ;
    scf:inputType "human"@ko .
scf:spec a scf:Concept ;
    rdfs:label "검증 사양"@ko ;
    scf:description "판매 페이지에서 사람이 확인한 사양(key·값·단위·출처·확인 시각). 영상·캡션 속 숫자는 이것과 같아야 통과."@ko ;
    scf:status "short" ;
    scf:area "② 상품"@ko ;
    scf:maturity "M0"@ko ;
    scf:inputType "human"@ko .
scf:caution a scf:Concept ;
    rdfs:label "주의사항·비추천"@ko ;
    scf:description "설치 조건·하중·호환처럼 사기 전에 확인할 것과 맞지 않는 사람. 영상의 '확인할 점' 장면에 반드시 나온다."@ko ;
    scf:status "short" ;
    scf:area "② 상품"@ko ;
    scf:maturity "M0"@ko ;
    scf:inputType "human"@ko .
scf:price a scf:Concept ;
    rdfs:label "가격·재고 확인"@ko ;
    scf:description "가격과 재고는 확인 시각과 함께만 쓴다. 24시간이 지나면 랜딩에서 숨기고 게시를 막는다."@ko ;
    scf:status "mid" ;
    scf:area "② 상품"@ko ;
    scf:maturity "M1"@ko ;
    scf:inputType "human"@ko .
scf:image a scf:Concept ;
    rdfs:label "상품 이미지"@ko ;
    scf:description "상품 원본 이미지와 권리 상태. 권리가 불분명하면 영상에 쓰지 않고 콘텐츠를 멈춘다."@ko ;
    scf:status "out" ;
    scf:area "② 상품"@ko ;
    scf:maturity "M0"@ko ;
    scf:inputType "human"@ko .
scf:usage a scf:Concept ;
    rdfs:label "실사용 확인"@ko ;
    scf:description "직접 써 보고 찍은 기록. 있어야만 '써보니'류 경험 표현을 허용한다. 신뢰·원본성 정책 모두에 가장 유리."@ko ;
    scf:status "out" ;
    scf:area "② 상품"@ko ;
    scf:maturity "M0"@ko ;
    scf:inputType "field"@ko .
scf:score a scf:Concept ;
    rdfs:label "평가"@ko ;
    scf:description "8개 항목 100점. 근거 없는 항목은 만점의 30%까지만(mock 근거는 80%). 항목마다 근거 문장 저장."@ko ;
    scf:status "done" ;
    scf:area "③ 판단"@ko ;
    scf:maturity "M3"@ko ;
    scf:inputType "system"@ko .
scf:filter a scf:Concept ;
    rdfs:label "필터 판정"@ko ;
    scf:description "점수와 별개인 필수 조건. 제외(품절·효과 주장·규제·중복)와 보류(권리·사양·가격 만료·판매자)를 나눈다."@ko ;
    scf:status "done" ;
    scf:area "③ 판단"@ko ;
    scf:maturity "M3"@ko ;
    scf:inputType "system"@ko .
scf:selection a scf:Concept ;
    rdfs:label "선정"@ko ;
    scf:description "상위 5개를 순서대로 재검증해 처음 통과한 1개. 기준 점수 미달이면 그날은 만들지 않는다."@ko ;
    scf:status "done" ;
    scf:area "③ 판단"@ko ;
    scf:maturity "M3"@ko ;
    scf:inputType "system"@ko .
scf:content a scf:Concept ;
    rdfs:label "콘텐츠"@ko ;
    scf:description "상품 1개 = 하루 1개. 생성 → 승인 대기 → 승인 → 게시, 또는 차단·수정 요청·거절."@ko ;
    scf:status "done" ;
    scf:area "④ 콘텐츠"@ko ;
    scf:maturity "M2"@ko ;
    scf:inputType "system"@ko .
scf:script a scf:Concept ;
    rdfs:label "대본"@ko ;
    scf:description "5장면 28초(후킹·불편·사용법·장점과 주의·대상과 안내). 각 장면이 인용한 사양을 fact_refs 로 남긴다."@ko ;
    scf:status "now" ;
    scf:area "④ 콘텐츠"@ko ;
    scf:maturity "M2"@ko ;
    scf:inputType "system"@ko .
scf:variant a scf:Concept ;
    rdfs:label "후킹 변형"@ko ;
    scf:description "A=문제 공감형, B=사용 결과 설명형. 첫 장면만 다르고 나머지는 같다(조건 통제)."@ko ;
    scf:status "short" ;
    scf:area "④ 콘텐츠"@ko ;
    scf:maturity "M1"@ko ;
    scf:inputType "system"@ko .
scf:disclosure a scf:Concept ;
    rdfs:label "광고 표시"@ko ;
    scf:description "전 장면 '광고' 배지, 첫·끝 장면 문구, 캡션 첫 줄, 첫 해시태그 #광고, 유튜브 제목 [광고]. 조건부 표현 금지."@ko ;
    scf:status "done" ;
    scf:area "④ 콘텐츠"@ko ;
    scf:maturity "M3"@ko ;
    scf:inputType "system"@ko .
scf:media a scf:Concept ;
    rdfs:label "미디어 산출물"@ko ;
