# .env.example → .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다(.gitignore).
# 비밀값 칸은 비워 둔 채로 커밋한다. 값이 없으면 해당 기능은 mock/연동 대기 상태로 동작한다.

# ---------- 기본 ----------
# dev | prod  (prod 는 SCF_SECRET_KEY 필수)
SCF_ENV=dev
# 세션 서명용 임의 문자열 (python -c "import secrets;print(secrets.token_urlsafe(32))")
SCF_SECRET_KEY=
# 관리자 화면 비밀번호 — 비우면 로그인 불가
SCF_ADMIN_PASSWORD=
# n8n 등에서 /api/jobs/run 호출용 토큰
SCF_API_TOKEN=
SCF_SITE_BASE_URL=http://localhost:5000
# 인스타그램이 영상을 가져갈 공개 URL (예: https://내도메인/media) — 없으면 IG 게시 대기
SCF_PUBLIC_MEDIA_BASE_URL=
SCF_TIMEZONE=Asia/Seoul
# SCF_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/scf   # 기본은 data/scf.db (SQLite)
# SCF_OUTPUT_DIR=                 # 기본 ./outputs
# SCF_FONT_PATH=                  # 한글 폰트 직접 지정 시

# ---------- 운영 안전장치 ----------
# true 여도 사람 승인 없는 콘텐츠는 게시 안 됨
AUTO_PUBLISH=false
# 하루 생성 콘텐츠 상한 (수익성 입증 전 1)
SCF_DAILY_CONTENT_LIMIT=1
# 24시간 자동 게시 상한
SCF_DAILY_PUBLISH_LIMIT=2
# 최종 선정 최소 점수 (미달이면 그날은 제작 안 함)
SCF_MIN_FINAL_SCORE=55
# 가격 확인 유효시간
SCF_PRICE_TTL_HOURS=24
# 유료 API 일일 상한
SCF_COST_CAP_DAILY_KRW=3000
# 유료 API 월 상한
SCF_COST_CAP_MONTHLY_KRW=50000
# 비용 환산 환율 (직접 갱신)
SCF_USD_KRW=1400
# 제휴 제공 이미지를 영상에 쓰려면 약관 확인 후 true
SCF_ALLOW_PARTNER_IMAGES_IN_VIDEO=false
# A/B 후킹 영상을 둘 다 렌더
SCF_RENDER_BOTH_VARIANTS=false
SCF_RENDER_FPS=30
SCF_EVENT_RETENTION_DAYS=90
SCF_JOB_MAX_ATTEMPTS=3

# ---------- 어댑터 선택 ----------
# mock | naver
SCF_TREND_PROVIDER=mock
# mock | manual | coupang
SCF_PRODUCT_PROVIDER=mock
# mock | anthropic
SCF_LLM_PROVIDER=mock
# none | user_file
SCF_TTS_PROVIDER=none
SCF_ANTHROPIC_MODEL=claude-opus-5-5
SCF_ANTHROPIC_EFFORT=medium

# ---------- 외부 자격증명 (직접 발급 후 입력) ----------
ANTHROPIC_API_KEY=
# developers(기존 개발자센터 키, 2027-06-30까지) | apihub(NCP API HUB)
NAVER_API_MODE=developers
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# API HUB 콘솔에서 확인한 DataLab 기본 URL
NAVER_APIHUB_BASE_URL=
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=
# 쿠팡파트너스 최종 승인 후 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# 처음엔 private 로 올려 Studio 에서 확인 후 공개 권장
YOUTUBE_PRIVACY_STATUS=private
